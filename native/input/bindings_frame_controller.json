{
  "controller_type": "frame_controller",
  "name": "Frame Workspace",
  "bindings": {
    "/actions/workspace": {
      "poses": [
        {"output": "/actions/workspace/in/aim", "path": "/user/hand/left/pose/tip"},
        {"output": "/actions/workspace/in/aim", "path": "/user/hand/right/pose/tip"}
      ],
      "sources": [
        {"path": "/user/hand/left/input/y", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/switcher"}}},
        {"path": "/user/hand/left/input/trigger", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/grab"}}},
        {"path": "/user/hand/right/input/trigger", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/grab"}}},
        {"path": "/user/hand/left/input/grip", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/squeeze"}}},
        {"path": "/user/hand/right/input/grip", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/squeeze"}}},
        {"path": "/user/hand/right/input/b", "mode": "button", "inputs": {"click": {"output": "/actions/workspace/in/secondary"}}},
        {"path": "/user/hand/left/input/thumbstick", "mode": "joystick", "inputs": {"position": {"output": "/actions/workspace/in/scroll"}}},
        {"path": "/user/hand/right/input/thumbstick", "mode": "joystick", "inputs": {"position": {"output": "/actions/workspace/in/scroll"}}}
      ],
      "haptics": [
        {"output": "/actions/workspace/out/haptic", "path": "/user/hand/left/output/haptic"},
        {"output": "/actions/workspace/out/haptic", "path": "/user/hand/right/output/haptic"}
      ]
    }
  }
}
